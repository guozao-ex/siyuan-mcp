# MCP Server Environment Variables
#
# 用法：把本文件复制成同目录下的 .env，服务器启动时会**自动加载**它
# （src/utils/env-file.ts，零依赖实现）。无需额外命令行参数。
#
# 规则：
#   - 真实环境变量优先：已存在于进程环境中的键不会被 .env 覆盖，
#     因此 CI / 容器注入的环境变量仍然有效。
#   - 想加载其它文件：设置 DOTENV_PATH。
#   - 文件不存在也没关系（.env 是可选的）。

# SiYuan API Configuration
SIYUAN_API_URL=http://127.0.0.1:6806
SIYUAN_API_TOKEN=

# MCP Transport Mode
# Options: stdio, http
MCP_TRANSPORT=http

# HTTP Server Configuration (only used when MCP_TRANSPORT=http)
MCP_PORT=3000
MCP_HOST=127.0.0.1

# HTTP 模式的访问认证（可选，但强烈建议设置）
#
# 设置后，除 GET /health 外的所有端点都要求请求头：
#   Authorization: Bearer <MCP_AUTH_TOKEN>
# 覆盖范围包括标准 MCP 端点（/mcp）与自定义 REST 端点（/tools/call、/create、/delete 等）——
# 它们都能创建、修改、删除笔记。
#
# 注意：若 MCP_HOST 不是回环地址（127.0.0.1 / localhost / ::1），本项为**必填**，
#       否则服务器会拒绝启动。仅绑回环地址时可以留空，启动时会打印警告。
#
# 生成一个随机值：node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
MCP_AUTH_TOKEN=

# 让标准 MCP 端点用普通 JSON 响应代替 SSE 流（默认关闭，协议推荐 SSE）
# MCP_HTTP_JSON_RESPONSE=1
